# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MySQL connection string (MySQL 8.0+).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://haley:change-me@localhost:3306/haley"

# First super admin, created by `npm run db:seed`. Only used when seeding;
# you can remove these after the account exists. Password must be 10+ characters.
SEED_ADMIN_NAME="Haley Bettle"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
