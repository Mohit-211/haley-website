# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the site, used for absolute links in social share previews.
SITE_URL="https://www.example.com"

# MySQL connection string (MySQL 8.0+).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://haley:change-me@localhost:3306/haley"

# First super admin, created by `npm run db:seed`. Only used when seeding;
# you can remove these after the account exists. Password must be 10+ characters.
SEED_ADMIN_NAME="Haley Bettle"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Where uploaded property photos are stored. Defaults to ../storage/images, i.e. a
# "storage/images" folder next to this "website" folder:
#   haley/website          (this app)
#   haley/storage/images   (photos — back this folder up; deploys never touch it)
# Leave empty to use that default, or set an absolute path, e.g. on the VPS:
#   IMAGES_DIR="/home/haley/haley/storage/images"
IMAGES_DIR=""
